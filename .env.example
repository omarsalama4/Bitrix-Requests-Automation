BITRIX_URL=https://cultiv.bitrix24.com/marketplace/app/26/

# Used for automatic login recovery if the saved Playwright session expires.
# This cannot bypass Bitrix MFA, captcha, SSO, or manual verification.
BITRIX_EMAIL=
BITRIX_PASSWORD=

# Keep DRY_RUN=true until the first live validation is reviewed.
DRY_RUN=true
ACCEPT_MODE=bulk
RUN_EVERY_HOURS=5
HEADLESS=true

# Set to false on production servers if you do not want screenshots, traces,
# summary JSON, or network logs written to disk.
SAVE_OUTPUT_FILES=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Business recipients receive one daily report at 10:00 AM Africa/Cairo,
# including days when zero partner requests were accepted. Leave empty to disable.
# Separate multiple addresses with commas or semicolons.
BUSINESS_EMAIL_TO=business1@example.com,business2@example.com

# Developer recipients receive one daily report with every execution and its log.
# Separate multiple addresses with commas or semicolons.
DEV_EMAIL_TO=devops@example.com,developer@example.com

# EMAIL_TO is no longer used. Only BUSINESS_EMAIL_TO enables business mail.
