BITRIX_URL=https://cultiv.bitrix24.com/marketplace/app/26/
BITRIX_EMAIL=
BITRIX_PASSWORD=

# Keep DRY_RUN=true until the first live validation is reviewed.
DRY_RUN=true
ACCEPT_MODE=bulk
RUN_EVERY_HOURS=5
HEADLESS=true

# Set to false on production servers if you do not want screenshots, traces,
# summary JSON, or network logs written to disk.
SAVE_OUTPUT_FILES=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Business recipients only receive a concise report when at least one request is accepted.
# Separate multiple addresses with commas or semicolons.
BUSINESS_EMAIL_TO=business1@example.com,business2@example.com

# Developer recipients receive a report for every execution, including dry runs and failures.
# Separate multiple addresses with commas or semicolons.
DEV_EMAIL_TO=devops@example.com,developer@example.com

# Legacy fallback for business recipients if BUSINESS_EMAIL_TO is empty.
EMAIL_TO=
